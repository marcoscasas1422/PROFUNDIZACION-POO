              ],
              "path": [
                "teacher"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"names\": \"Juan\",\n  \"lastNames\": \"Pérez\",\n  \"email\": \"juan.perez@correo.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
